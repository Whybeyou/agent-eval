            "dwd_parcels.area_m2"
          ]
        }
      },
      {
        "id": "meta",
        "dim": "result",
        "type": "json_field",
        "params": {
          "field": "quality_status",
          "equals": "warn"
        }
      }
    ]
  },
  {
    "id": "DH-P08",
    "category": "正向-服务",
    "task": "指标接口契约稳定（字段齐全、有数据）",
    "turns": [
      "调指标接口"
    ],
    "scenario": "api_contract",
    "golden": {
      "facts": [
        "/metrics/summary 返回 metric/count/items"
      ]
