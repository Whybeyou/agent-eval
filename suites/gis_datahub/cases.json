    "checks": [
      {
        "id": "code",
        "dim": "process",
        "type": "http_status",
        "params": {
          "in": [
            200
          ]
        }
      },
      {
        "id": "shape",
        "dim": "result",
        "type": "api_shape",
        "params": {
          "keys": [
            "metric",
            "count",
            "items"
          ]
        }
      }
    ]
  },
  {
    "id": "DH-N01",
    "category": "负向-越权",
