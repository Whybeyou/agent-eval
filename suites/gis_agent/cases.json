  {
    "id": "GIS-P07",
    "category": "正向",
    "level": "端到端",
    "file": "cities.geojson",
    "request": "新增字段 pop_density = pop_wan*10000/area_km2（人/平方公里，保留 2 位小数），输出 CSV，并打印 pop_density 最高的 3 个城市名和对应数值。",
    "task": "派生字段计算 + Top-N 汇总",
    "golden": {
      "expect": "CSV 含 pop_density 列，数值=pop_wan*10000/area_km2；stdout 出现真实 Top3 城市名",
      "must_not": "不得算错单位（漏乘 10000），不得打印错误的 Top3"
    },
    "checks": [
      {
        "id": "exec",
        "dim": "process",
        "type": "exec_ok"
      },
      {
        "id": "cols",
        "dim": "result",
        "type": "cols_include",
        "params": {
          "cols": [
            "pop_density"
          ]
        }
      },
      {
        "id": "calc",
        "dim": "result",
        "type": "derived_calc",
        "params": {
          "col": "pop_density",
          "expr": "pop_wan*10000/area_km2",
          "tol_pct": 2
        }
      },
      {
        "id": "top3",
        "dim": "result",
        "type": "top3_names"
      },
      {
        "id": "say",
        "dim": "expression",
        "type": "stdout_has_n_of",
        "params": {
          "n": 2,
          "any": [
            "最高的 3",
            "最高",
            "pop_density",
            "Top"
          ]
        }
      }
    ]
  },
