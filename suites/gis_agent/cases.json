[
  {
    "id": "GIS-P01",
    "category": "正向",
    "level": "端到端",
    "file": "cities.geojson",
    "request": "把坐标系从 WGS84(EPSG:4326) 转成 CGCS2000(EPSG:4490)，输出 GeoJSON，并打印转换后的坐标系和记录数。",
    "task": "坐标系转换 + 结果自检输出",
    "golden": {
      "expect": "输出一个 CRS 为 CGCS2000(EPSG:4490) 的 GeoJSON，要素数不变(50)，stdout 打印新坐标系与记录数",
      "must_not": "不得只改字段名不改 crs，不得丢行"
    },
    "checks": [
      {
        "id": "exec",
        "dim": "process",
        "type": "exec_ok"
      },
      {
        "id": "file",
        "dim": "result",
        "type": "file_ext",
        "params": {
          "exts": [
            ".geojson",
            ".json"
          ]
        }
      },
      {
        "id": "crs",
        "dim": "result",
        "type": "crs_family",
        "params": {
          "family": "CGCS2000"
        }
      },
      {
        "id": "rows",
        "dim": "result",
        "type": "rows_eq",
        "params": {
          "n": 50
        }
      },
      {
        "id": "say",
        "dim": "expression",
        "type": "stdout_has",
        "params": {
          "any": [
            "CGCS2000",
            "4490"
          ],
          "also": [
            "50"
          ]
        }
      }
    ]
  },
  {
    "id": "GIS-P02",
    "category": "正向",
    "level": "端到端",
    "file": "parcels_cgcs2000.shp",
    "request": "筛选 area_m2 大于 100000 的地块，导出新的 Shapefile，并打印筛选前后的记录数。",
    "task": "属性条件筛选（数值阈值）",
    "golden": {
      "expect": "输出要素数 = 源数据中 area_m2>100000 的记录数；保留原坐标系；打印前后数量",
      "must_not": "不得把字符串比较当数值比较，不得清空全部要素"
    },
    "checks": [
      {
        "id": "exec",
        "dim": "process",
        "type": "exec_ok"
      },
      {
        "id": "file",
        "dim": "result",
        "type": "file_ext",
        "params": {
          "exts": [
            ".shp",
            ".geojson"
          ]
        }
      },
      {
        "id": "rows",
        "dim": "result",
        "type": "rows_filter",
        "params": {
          "col": "area_m2",
          "op": ">",
          "val": 100000
        }
      },
      {
        "id": "crs",
        "dim": "result",
        "type": "crs_family",
        "params": {
          "family": "CGCS2000"
        }
      },
      {
        "id": "say",
        "dim": "expression",
        "type": "stdout_has",
        "params": {
          "any": [
            "20"
          ]
        }
      }
    ]
  },
  {
    "id": "GIS-P03",
    "category": "正向",
    "level": "端到端",
    "file": "cities.geojson",
    "request": "以每个城市点为中心做 10 公里缓冲区，输出面要素 GeoJSON，打印面要素数量。注意缓冲区要在投影坐标系下计算，不要在经纬度上直接加 0.09 度。",
    "task": "投影坐标系下的缓冲区分析（含单位陷阱提示）",
    "golden": {
      "expect": "先投影到米制坐标系(如 EPSG:3857 或 4547)再 buffer(10000)，输出 50 个面要素",
      "must_not": "不得在 EPSG:4326 下直接 buffer(0.09)；不得只做属性表不生成几何"
    },
    "checks": [
      {
        "id": "exec",
        "dim": "process",
        "type": "exec_ok"
      },
      {
        "id": "geom",
        "dim": "result",
        "type": "geom_type_in",
        "params": {
          "types": [
            "Polygon",
            "MultiPolygon"
          ]
        }
      },
      {
        "id": "rows",
        "dim": "result",
        "type": "rows_eq",
        "params": {
          "n": 50
        }
      },
      {
        "id": "area",
        "dim": "result",
        "type": "min_area_km2",
        "params": {
          "km2": 200
        }
      },
      {
        "id": "say",
        "dim": "expression",
        "type": "stdout_has",
        "params": {
          "any": [
            "50"
          ]
        }
      }
    ]
  },
  {
